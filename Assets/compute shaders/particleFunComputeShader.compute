#pragma kernel CSParticle
#pragma kernel CSClear

struct particle
{
    float2 pos;
    float2 vel;
    float life;
};
RWStructuredBuffer<particle> particlesBuffer;

uint particleCount;

float dt;
float2 mousePos;
float2 spawnerPos;
float2 bounds;

float xorshift(uint hash)
{
    uint x = hash;
    x ^= (x << 13);
    x ^= (x >> 17);
    x ^= (x << 5);
    return x / 4294967295.0;
}

void respawn(uint id)
{
    float2 randomDir = float2(xorshift(id + 1), xorshift(id + 120));
    particlesBuffer[id].pos = spawnerPos;
    particlesBuffer[id].vel = randomDir;
    particlesBuffer[id].life = 5;
}

RWTexture2D<float> densityMap;
float2 res;
float thickness;

[numthreads(8, 8, 1)]
void CSClear(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) res.x || id.y >= (uint) res.y)
        return;
    densityMap[id.xy] = 0;
}

[numthreads(256, 1, 1)]
void CSParticle(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= particleCount) return;
    particle current = particlesBuffer[id.x];
    
    current.life -= dt;
    current.vel += normalize(mousePos - current.pos) * current.life * dt * 5;
    current.pos += current.vel * dt;
    
    if (abs(current.pos.x) > bounds.x)
    {
        current.pos.x = bounds.x * sign(current.pos.x);
        current.vel.x *= -1;
    }
    if (abs(current.pos.y) > bounds.y)
    {
        current.pos.y = bounds.y * sign(current.pos.y);
        current.vel.y *= -1;
    }
    
    uint2 pixelPos = clamp((uint2) (((current.pos + bounds) / (2.0 * bounds)) * res), uint2(0, 0), uint2(res) - 1);
    densityMap[pixelPos.xy] = clamp(densityMap[pixelPos.xy] + thickness, 0, 1);
    
    particlesBuffer[id.x] = current;
    if (current.life <= 0) respawn(id.x);
}
